# Oslo Commute Time Optimizer - Environment Variables
# Version 2.0.0

# ==============================================================================
# API Keys (At least one data source required)
# ==============================================================================

# Google Maps API Configuration
# Get your API key from: https://console.cloud.google.com/
# Enable: Directions API
# Note: Requires credit card on file, but first $200/month is free
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# DATEX API Configuration
# Register at: https://www.vegvesen.no/trafikkdata/datex/
# Free registration, takes 1-2 business days to receive credentials
DATEX_USERNAME=your_datex_username_here
DATEX_PASSWORD=your_datex_password_here

# ==============================================================================
# Server Configuration
# ==============================================================================

# Server host (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
HOST=0.0.0.0

# Server port
PORT=8000

# Debug mode (true/false) - enables detailed error messages
DEBUG=false

# ==============================================================================
# Logging Configuration
# ==============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: Log file path (leave empty for console only)
# LOG_FILE=/var/log/commute-optimizer.log

# ==============================================================================
# Database Configuration
# ==============================================================================

# Optional: Custom database path (default: ./data/commute.db)
# DB_PATH=/custom/path/commute.db

# ==============================================================================
# DATEX Collection Settings
# ==============================================================================

# Polling interval in seconds (default: 300 = 5 minutes)
DATEX_POLL_INTERVAL_SECONDS=300

# API request timeout in seconds
DATEX_TIMEOUT_SECONDS=30

# Auto-start collection on application startup (true/false)
DATEX_AUTO_START=false

# ==============================================================================
# Analysis Settings
# ==============================================================================

# Analysis time range (24-hour format)
ANALYSIS_START_HOUR=6
ANALYSIS_END_HOUR=10

# Interval between queries in minutes
ANALYSIS_INTERVAL_MINUTES=15

# Minimum samples required for quality data
MIN_SAMPLES_FOR_QUALITY=3

# ==============================================================================
# Google Maps Settings
# ==============================================================================

# API request timeout in seconds
GOOGLE_MAPS_TIMEOUT_SECONDS=10

# Traffic model: best_guess, pessimistic, or optimistic
GOOGLE_MAPS_TRAFFIC_MODEL=best_guess

# ==============================================================================
# CORS Settings
# ==============================================================================

# Allowed origins (comma-separated, use * for all)
CORS_ORIGINS=*
